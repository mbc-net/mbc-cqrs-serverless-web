{
	"name": "@mbc-cqrs-serverless-web/survey",
	"version": "1.0.0",
	"description": "Survey components and creators for MBC applications",
	"main": "dist/index.js",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"files": ["dist", "src/styles"],
	"exports": {
		".": {
			"import": "./dist/index.esm.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./styles": "./src/styles/index.css"
	},
	"scripts": {
		"build": "rollup -c rollup.config.mjs",
		"dev": "rollup -c rollup.config.mjs -w",
		"type-check": "tsc --noEmit",
		"lint": "eslint src --ext .ts,.tsx",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"peerDependencies": {
		"@mbc-cqrs-serverless-web/shared-ui": "^1.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-hook-form": "^7.55.0",
		"zod": "^3.24.2"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@hookform/resolvers": "^5.0.1"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"rollup-plugin-postcss": "^4.0.2",
		"@rollup/plugin-typescript": "^12.1.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.2",
		"rollup": "^4.28.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"@rollup/plugin-terser": "^0.4.4",
		"typescript": "^5.8.3",
		"vitest": "^2.1.8",
		"@testing-library/react": "^16.0.1",
		"@testing-library/jest-dom": "^6.6.3",
		"eslint": "^9.17.0"
	},
	"keywords": ["survey", "forms", "react", "typescript", "mbc", "components"],
	"author": "MBC Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mbc-cqrs-serverless-web/survey.git"
	},
	"bugs": {
		"url": "https://github.com/mbc-cqrs-serverless-web/survey/issues"
	},
	"homepage": "https://github.com/mbc-cqrs-serverless-web/survey#readme"
}

{
	"name": "@mbc-cqrs-serverless-web/shared-ui",
	"version": "1.0.0",
	"description": "MBC Shared UI Component Library",
	"main": "dist/index.js",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"files": ["dist", "src/styles"],
	"exports": {
		".": {
			"import": "./dist/index.esm.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./server": {
			"import": "./dist/server.esm.js",
			"require": "./dist/server.js",
			"types": "./dist/server.d.ts"
		},
		"./styles": {
			"import": "./dist/styles.css",
			"require": "./dist/styles.css",
			"default": "./dist/styles.css"
		},
		"./styles/theme": {
			"import": "./src/styles/theme.css",
			"require": "./src/styles/theme.css",
			"default": "./src/styles/theme.css"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "NODE_ENV=production rollup -c rollup.config.mjs",
		"build:dev": "NODE_ENV=development rollup -c rollup.config.mjs",
		"build:optimized": "NODE_ENV=production rollup -c rollup.optimized.config.mjs",
		"build:analyze": "npm run build:optimized && open dist/bundle-analysis.html",
		"dev": "NODE_ENV=development rollup -c rollup.config.mjs -w",
		"watch": "npm run dev",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prebuild": "npm run clean",
		"prepublishOnly": "npm run build",
		"size": "npm run build && npx size-limit",
		"analyze": "npm run build && npx rollup-plugin-visualizer dist/stats.html"
	},
	"size-limit": [
		{
			"path": "dist/index.esm.js",
			"limit": "50 KB",
			"gzip": true
		},
		{
			"path": "dist/server.esm.js",
			"limit": "10 KB",
			"gzip": true
		}
	],
	"keywords": [
		"react",
		"ui",
		"components",
		"typescript",
		"design-system",
		"mbc"
	],
	"author": "MBC Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mbc-cqrs-serverless-web/monorepo.git",
		"directory": "packages/shared-ui"
	},
	"bugs": {
		"url": "https://github.com/mbc-cqrs-serverless-web/monorepo/issues"
	},
	"homepage": "https://github.com/mbc-cqrs-serverless-web/monorepo/tree/main/packages/shared-ui#readme",
	"peerDependencies": {
		"@radix-ui/react-accordion": "^1.2.11",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-checkbox": "^1.3.1",
		"@radix-ui/react-collapsible": "^1.1.10",
		"@radix-ui/react-label": "^2.1.6",
		"@radix-ui/react-radio-group": "^1.2.1",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-select": "^2.2.4",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.12",
		"@radix-ui/react-toast": "^1.2.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^3.6.0",
		"lucide-react": "^0.525.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-day-picker": "^9.8.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"tailwind-merge": "^3.2.0"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "^1.2.11",
		"@radix-ui/react-alert-dialog": "^1.1.14",
		"@radix-ui/react-collapsible": "^1.1.10",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.14",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-popover": "^1.1.14",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-separator": "^1.1.6",
		"@radix-ui/react-tabs": "^1.1.12",
		"@radix-ui/react-toast": "^1.2.7",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@radix-ui/react-visually-hidden": "^1.2.3",
		"cmdk": "^1.1.1",
		"date-fns": "^3.6.0",
		"react-day-picker": "^9.8.0",
		"sonner": "^2.0.6"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.0",
		"@size-limit/preset-small-lib": "^11.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.2",
		"@typescript-eslint/eslint-plugin": "^8.18.1",
		"@typescript-eslint/parser": "^8.18.1",
		"@vitejs/plugin-react": "^4.7.0",
		"eslint": "^9.17.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"jsdom": "^27.0.0",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.0",
		"postcss-preset-env": "^10.0.0",
		"rollup": "^4.28.1",
		"rollup-plugin-analyzer": "^4.0.0",
		"rollup-plugin-dts": "^6.1.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-visualizer": "^6.0.4",
		"size-limit": "^11.2.0",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.8.3",
		"vitest": "^2.1.9"
	},
	"publishConfig": {
		"access": "public"
	}
}
